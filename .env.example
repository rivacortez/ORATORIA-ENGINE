# Copy to .env for local development. Never commit .env.
#
# The two secrets have no defaults: the process refuses to start without them.
# A default value is how a development placeholder reaches production, and a
# crash at boot is the cheapest possible discovery of a missing secret.
# Real values come from the secret manager (spec section 15.2), not from here.

ENGINE_ENVIRONMENT=local

# memory | postgres
# `memory` needs no infrastructure and is what the contract suite runs on.
ENGINE_BACKEND=memory

# deterministic | managed
# `deterministic` replays scripts and produces byte-identical evidence for
# identical input, which is what QA-05's reproducibility check is built on.
ENGINE_RUNTIME_MODE=deterministic

# --- secrets: required, minimum 32 characters -------------------------------
ENGINE_API_KEY_PEPPER=
ENGINE_STREAM_TOKEN_SIGNING_KEY=

# --- infrastructure: required when ENGINE_BACKEND=postgres ------------------
ENGINE_DATABASE_URL=postgresql+asyncpg://engine:engine@localhost:5432/engine
ENGINE_REDIS_URL=redis://localhost:6379/0
ENGINE_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
ENGINE_OBJECT_STORAGE_BUCKET=evidence-engine
ENGINE_OBJECT_STORAGE_ACCESS_KEY=
ENGINE_OBJECT_STORAGE_SECRET_KEY=

# --- behaviour --------------------------------------------------------------
# Windows in flight before the client is told to slow down (FR-010). Small on
# purpose: a deep queue meets a throughput target by spending exactly the
# latency budget NFR-005 measures.
ENGINE_MAX_QUEUE_DEPTH=8
ENGINE_STREAM_LEASE_TTL_SECONDS=60
# Sessions per application per minute. Zero means unlimited: NFR-023 wants
# quotas configurable, not mandatory.
ENGINE_SESSIONS_PER_MINUTE=0
